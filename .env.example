# Obtain these from https://my.telegram.org. Never commit real values.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Use PostgreSQL in production, e.g. postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./data/teleautomata.sqlite3
SESSION_DIR=./sessions
LOG_LEVEL=INFO
# Conservative defaults. Increase only after observing normal operation.
MAX_CONCURRENCY=2
ACCOUNT_CONCURRENCY=1
MIN_REQUEST_INTERVAL_SECONDS=1.0
MAX_RETRIES=3
MAX_FLOOD_WAIT_SECONDS=3600

